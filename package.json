{
  "name": "@matchory/docker-swarm-deployment-action",
  "description": "A GitHub Action to deploy a Docker Swarm stack.",
  "version": "1.6.0",
  "author": {
    "name": "Moritz Friedrich",
    "email": "moritz@matchory.com",
    "url": "https://matchory.com"
  },
  "type": "module",
  "private": true,
  "homepage": "https://github.com/matchory/docker-swarm-deployment-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matchory/docker-swarm-deployment-action.git"
  },
  "bugs": {
    "url": "https://github.com/matchory/docker-swarm-deployment-action/issues"
  },
  "keywords": [
    "actions",
    "docker",
    "docker-swarm",
    "deployment",
    "cluster",
    "devops"
  ],
  "main": "src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "postversion": "npm run licensed && npm run all",
    "bundle": "node script/bundle.mjs",
    "ci-test": "npx vitest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx @biomejs/biome check --write --unsafe",
    "format:check": "npx @biomejs/biome format",
    "lint": "npx @biomejs/biome lint",
    "licensed": "licensed cache",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npm run bundle",
    "prepackage": "npm ls >/dev/null 2>&1 || (echo 'Installed dependencies do not match package-lock.json, so the bundle built here would not match the one check-dist builds after npm ci. Run npm ci first.' >&2 && exit 1)",
    "typecheck": "npx tsc --noEmit && npx tsc -p tsconfig.node.json",
    "test": "npx vitest --run",
    "test:swarm": "npx vitest --run --config vitest.swarm.config.ts",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.1",
    "globals": "^17.12.0",
    "make-coverage-badge": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@bufbuild/protobuf": "2.11.0"
  }
}
