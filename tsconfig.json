{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": false,
    "types": ["node"]
  },
  "exclude": ["tests", "coverage", "dist", "node_modules"],
  "include": ["src/**/*.ts"]
}
